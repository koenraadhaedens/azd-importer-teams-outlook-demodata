# Azure ACI runtime settings; azd/Bicep supplies these, not local credentials.
TENANT_ID=
# Created and persisted by the azd postprovision registration hook.
WEB_CLIENT_ID=
MANAGED_IDENTITY_CLIENT_ID=
# Discovered from ACI and saved by the azd postprovision hook; do not preconfigure.
PUBLIC_URL=
PUBLIC_HOSTNAME=
ACME_EMAIL=operator@example.org
# azd setting: anonymous image pulls by default; true only for private same-tenant ACR.
USE_MANAGED_IDENTITY_FOR_IMAGE_PULL=false
# Runtime JSON array; azd setup also accepts a single GUID and serializes it.
OPERATOR_IDS=[]
AUTHORIZED_GROUP_ID=
DEMO_TENANT_CONFIRMED=false
DELIVERY_ENABLED=false
MAILBOX_SCOPE_CONFIRMED=false
ALLOW_EXTERNAL_RECIPIENTS=false
USERS_FILE=config/demo-users.yaml
RESOURCES_FILE=config/resources.yaml
# Optional external backend for custom deployments; the default ACI demo uses a local journal.
JOURNAL_BLOB_URL=
DATA_DIR=data
MAX_UPLOAD_BYTES=65536
MAX_CONCURRENCY=2
