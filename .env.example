# Copy to .env (ignored). Fill locally; never commit a completed copy.
TENANT_ID=
WEB_CLIENT_ID=
WEB_CLIENT_SECRET=
PUBLIC_URL=http://localhost:8000
# Compose HTTPS: set PUBLIC_URL=https://localhost and PUBLIC_HOSTNAME=localhost.
PUBLIC_HOSTNAME=localhost
ACME_EMAIL=operator@example.org
OPERATOR_IDS=[]
AUTHORIZED_GROUP_ID=
DEMO_TENANT_CONFIRMED=false
DELIVERY_ENABLED=false
MAILBOX_SCOPE_CONFIRMED=false
ALLOW_EXTERNAL_RECIPIENTS=false
USERS_FILE=config/demo-users.yaml
RESOURCES_FILE=config/resources.yaml
# Local mode only: separate application with User.Read.All + scoped mail.
MAIL_CLIENT_ID=
MAIL_CLIENT_SECRET=
# Azure deployment supplies managed identity and Key Vault settings instead.
MANAGED_IDENTITY_CLIENT_ID=
KEY_VAULT_URL=
WEB_SECRET_NAME=web-client-secret
JOURNAL_BLOB_URL=
DATA_DIR=data
MAX_UPLOAD_BYTES=65536
MAX_CONCURRENCY=2
